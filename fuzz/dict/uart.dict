"hi"
"ping"
"reset"
"START"
"STOP"

# Small lengths
"\x02" "\x03" "\x05" "\x0A" "\x20" "\x40"

# Structured byte pairs to tick CRC paths
"\x00\x00" "\xFF\xFF"